'use strict';
document.addEventListener('DOMContentLoaded', function() {
    var populationElements = document.querySelectorAll('.population');
    var populations = [];
    populationElements.forEach(function(element) {
        var text = element.textContent;
        var number = parseInt(text.replace(/,/g, ''), 10);
        if (!isNaN(number)) populations.push(number);
    });
    var totalPopulation = 0;
    populations.forEach(function(num) {
        totalPopulation += num;
    });
    var averagePopulation = Math.round(totalPopulation / populations.length);
    var totalElement = document.querySelector('.total-population');
    var averageElement = document.querySelector('.average-population');
    totalElement.textContent = totalPopulation.toLocaleString();
    averageElement.textContent = averagePopulation.toLocaleString();
});

